# ---- Copy this file to ".env" and fill in real values ----

# Flask secret key (used to sign session cookies). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Groq API key -> get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Groq model to use for chat generation (free tier models)
# Note: llama-3.3-70b-versatile was decommissioned by Groq in Aug 2026.
GROQ_MODEL=openai/gpt-oss-120b

# SQLite database location (relative to project root)
DATABASE_URL=sqlite:///instance/swasthyasaathi.db

# Admin console credentials (used to log into /admin)
ADMIN_EMAIL=admin@swasthyasaathi.local
ADMIN_PASSWORD=change-this-admin-password

# Set to "1" to enable Flask debug mode (never use in production)
FLASK_DEBUG=1
